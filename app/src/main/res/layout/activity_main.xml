<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">
  <FrameLayout
      android:id="@+id/map_host"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@string/map_description"/>
  <View
      android:layout_width="match_parent"
      android:layout_height="190dp"
      android:background="@drawable/bg_gradient_header"
      android:importantForAccessibility="no"/>
  <View
      android:layout_width="match_parent"
      android:layout_height="170dp"
      android:layout_gravity="bottom"
      android:background="@drawable/bg_gradient_footer"
      android:importantForAccessibility="no"/>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="20dp"
      android:paddingTop="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/texto_boas_vindas"
          style="@style/Rastro.ScreenTitle"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:text="@string/greeting_initial"
          android:maxLines="2"
          android:ellipsize="end"/>
      <androidx.appcompat.widget.AppCompatImageButton
          android:id="@+id/btn_configuracao"
          style="@style/Rastro.IconButton"
          android:layout_marginStart="12dp"
          android:src="@drawable/ic_settings"
          android:contentDescription="@string/cd_configuracao"
          app:tint="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ativar_rastro"
        style="@style/Rastro.Action"
        android:layout_marginTop="16dp"
        android:text="@string/activate_rastro_mode"
        android:textColor="@color/btn_ativar_fg"
        app:backgroundTint="@color/btn_ativar_bg"/>
    <LinearLayout
        android:id="@+id/layout_acoes_ativado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">
      <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_desativar_rastro"
          style="@style/Rastro.Action"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:text="@string/deactivate_rastro_mode"
          android:textColor="@color/btn_desativar_fg"
          app:backgroundTint="@color/btn_desativar_bg"/>
      <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_enviar_sos"
          style="@style/Rastro.Action"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:text="@string/send_sos"
          android:textColor="@color/btn_desativar_fg"
          app:backgroundTint="@color/btn_desativar_bg"/>
    </LinearLayout>
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:background="@drawable/bg_card_icon_button"
        android:text="@string/status_idle"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:accessibilityLiveRegion="polite"
        android:maxLines="2"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_alerta_sos"
        style="@style/Rastro.SettingsCard"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/view_sos_details"
        app:strokeColor="?attr/colorError">
      <TextView
          android:id="@+id/tv_ultimo_sos_resumo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12dp"
          android:maxLines="2"
          android:ellipsize="end"
          android:textSize="13sp"
          android:textColor="?attr/colorOnSurface"/>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginEnd="20dp"
      android:layout_marginBottom="105dp"
      android:orientation="vertical">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/fab_ver_sos"
        style="@style/Rastro.IconButton"
        android:layout_marginBottom="10dp"
        android:src="@drawable/ic_sos_location"
        android:contentDescription="@string/view_sos"
        android:enabled="false"
        app:tint="?attr/colorError"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/fab_minha_localizacao"
        style="@style/Rastro.IconButton"
        android:src="@drawable/ic_my_location"
        android:contentDescription="@string/my_location"
        android:enabled="false"
        app:tint="?attr/colorPrimary"/>
  </LinearLayout>
  <TextView
      android:id="@+id/map_details"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:layout_gravity="bottom|start"
      android:layout_marginStart="20dp"
      android:layout_marginBottom="100dp"
      android:paddingHorizontal="12dp"
      android:gravity="center_vertical"
      android:text="@string/map_quick_details"
      android:textSize="12sp"
      android:textColor="?attr/colorOnSurface"
      android:background="@drawable/bg_card_icon_button"
      android:clickable="true"
      android:focusable="true"/>
  <include
      layout="@layout/layout_bottom_nav"
      android:layout_width="160dp"
      android:layout_height="58dp"
      android:layout_gravity="bottom|center_horizontal"
      android:layout_marginBottom="24dp"/>
</FrameLayout>
