<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/custody_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/custody_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_back" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custody_title" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custody_description" android:paddingVertical="12dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/custody_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/custody_mode" />
            <TextView android:id="@+id/custody_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/custody_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>