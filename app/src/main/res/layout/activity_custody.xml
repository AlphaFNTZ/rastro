<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/custody_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/android:colorBackground">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="12dp">
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/custody_back" style="@style/Rastro.IconButton" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/chat_back" app:tint="?attr/colorOnSurfaceVariant"/>
<TextView android:id="@+id/custody_title" style="@style/Rastro.ScreenTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="15dp" android:textSize="20sp" android:text="@string/custody_title"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
<TextView style="@style/Rastro.Section" android:text="@string/custody_participation"/>
<com.google.android.material.card.MaterialCardView style="@style/Rastro.SettingsCard">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/custody_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/custody_mode" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold"/>
<TextView style="@style/Rastro.SupportingText" android:layout_marginTop="8dp" android:text="@string/custody_description"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<TextView style="@style/Rastro.Section" android:text="@string/custody_storage"/>
<com.google.android.material.card.MaterialCardView style="@style/Rastro.SettingsCard">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/custody_usage" style="@style/Rastro.ItemTitle" />
<com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/custody_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:max="128" app:trackCornerRadius="4dp" app:trackThickness="6dp" app:indicatorColor="?attr/colorPrimary" app:trackColor="?attr/colorSurfaceVariant"/>
<TextView android:id="@+id/custody_status" style="@style/Rastro.SupportingText" android:accessibilityLiveRegion="polite"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<TextView style="@style/Rastro.Section" android:text="@string/custody_pending"/>
<TextView android:id="@+id/custody_empty" style="@style/Rastro.EmptyState" android:paddingVertical="24dp" android:text="@string/custody_empty"/>
<LinearLayout android:id="@+id/custody_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
</ScrollView>
</LinearLayout>
