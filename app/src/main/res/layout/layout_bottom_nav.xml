<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation_bar"
    android:layout_width="160dp"
    android:layout_height="58dp"
    android:background="@drawable/bg_bottom_nav"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="5dp">
  <FrameLayout
      android:id="@+id/nav_item_home"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:clickable="true"
      android:focusable="true"
      android:contentDescription="@string/nav_home"
      android:foreground="?attr/selectableItemBackgroundBorderless">
    <ImageView
        android:id="@+id/nav_icon_home"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_nav_home"
        android:contentDescription="@null"
        app:tint="@color/nav_icon_unselected"/>
  </FrameLayout>
  <FrameLayout
      android:id="@+id/nav_item_devices"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:clickable="true"
      android:focusable="true"
      android:contentDescription="@string/nav_devices"
      android:foreground="?attr/selectableItemBackgroundBorderless">
    <ImageView
        android:id="@+id/nav_icon_devices"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_nav_devices"
        android:contentDescription="@null"
        app:tint="@color/nav_icon_unselected"/>
  </FrameLayout>
  <FrameLayout
      android:id="@+id/nav_item_history"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:clickable="true"
      android:focusable="true"
      android:contentDescription="@string/nav_history"
      android:foreground="?attr/selectableItemBackgroundBorderless">
    <ImageView
        android:id="@+id/nav_icon_history"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_nav_history"
        android:contentDescription="@null"
        app:tint="@color/nav_icon_unselected"/>
  </FrameLayout>
</LinearLayout>
