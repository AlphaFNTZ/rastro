<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_dispositivos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingHorizontal="20dp"
      android:paddingTop="26dp">
    <TextView
        style="@style/Rastro.ScreenTitle"
        android:text="@string/title_dispositivos"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">
      <ImageView
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:src="@drawable/ic_search"
          android:contentDescription="@null"
          app:tint="?attr/colorOnSurfaceVariant"/>
      <EditText
          android:id="@+id/et_buscar_dispositivos"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginStart="10dp"
          android:background="@null"
          android:hint="@string/search_hint"
          android:inputType="text"
          android:singleLine="true"
          android:importantForAutofill="no"
          android:imeOptions="actionSearch"
          android:textSize="15sp"
          android:textColor="?attr/colorOnSurface"
          android:textColorHint="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_data_dispositivos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv_dispositivos"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:paddingBottom="104dp"
          android:clipToPadding="false"/>
      <TextView
          android:id="@+id/tv_dispositivos_vazio"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="top"
          android:layout_marginTop="40dp"
          android:gravity="center"
          android:text="@string/empty_dispositivos"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:textSize="14sp"
          android:visibility="gone"/>
    </FrameLayout>
  </LinearLayout>
  <include
      layout="@layout/layout_bottom_nav"
      android:layout_width="160dp"
      android:layout_height="58dp"
      android:layout_gravity="bottom|center_horizontal"
      android:layout_marginBottom="24dp"/>
</FrameLayout>
