<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Rastro.ScreenTitle" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">24sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnBackground</item>
  </style>
  <style name="Rastro.Section" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">20dp</item>
    <item name="android:layout_marginBottom">8dp</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
  </style>
  <style name="Rastro.SettingsCard" parent="Widget.Material3.CardView.Outlined">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="cardBackgroundColor">?attr/colorSurface</item>
    <item name="cardCornerRadius">15dp</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeColor">?attr/colorOutline</item>
    <item name="strokeWidth">1dp</item>
  </style>
  <style name="Rastro.SettingsRow" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">50dp</item>
    <item name="android:paddingHorizontal">16dp</item>
    <item name="android:paddingVertical">12dp</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:background">?attr/selectableItemBackground</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>
  <style name="Rastro.IconButton" parent="">
    <item name="android:layout_width">48dp</item>
    <item name="android:layout_height">48dp</item>
    <item name="android:background">@drawable/bg_card_icon_button</item>
    <item name="android:padding">13dp</item>
    <item name="android:scaleType">fitCenter</item>
  </style>
  <style name="Rastro.Action" parent="Widget.Material3.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">50dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textAllCaps">false</item>
    <item name="cornerRadius">15dp</item>
  </style>
  <string name="map_details">Detalhes do mapa e SOS</string>
  <string name="no_search_results">Nenhum dispositivo corresponde à busca</string>
  <string name="diagnostics">Diagnóstico de sensores</string>
  <string name="licenses">Licenças e atribuição</string>
  <string name="status_idle">Rastro desativado</string>
  <string name="greeting_initial">Olá</string>
  <string name="map_quick_details">Localização · SOS · legenda</string>
  <string name="view_sos_details">Ver detalhes do último SOS</string>
  <string name="offline_resume">Pausar / retomar download</string>
</resources>
